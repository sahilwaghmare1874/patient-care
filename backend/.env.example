# Django Core Security & Configuration
DJANGO_SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (sqlite3 for local development, postgresql for production)
DB_ENGINE=sqlite3
POSTGRES_DB=patientcare_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS Configuration (Set False and specify CORS_ALLOWED_ORIGINS in production)
CORS_ALLOW_ALL_ORIGINS=True

# Phase 7: AI Service Integration (Google Gemini / OpenAI)
# Keys are strictly kept on the server; never exposed to frontend code
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=30

# Phase 8: Healthcare Insurance Reserve Account Policy
# Configurable percentage credited to patient's healthcare reserve account (default 90.0%)
RESERVE_CREDIT_PERCENTAGE=90.0
